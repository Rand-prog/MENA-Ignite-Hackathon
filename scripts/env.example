# SignalGuard — demo conductor configuration
# Copy to .env and fill in. Never commit .env. Never `export` these on camera.

SIGNALGUARD_BACKEND=http://localhost:8000

# Nokia Network as Code sandbox — real base URL and auth header, confirmed
# against the published API catalog (network-as-code.p-eu.apihub.nokia.io,
# header x-rapidapi-key). There is NO location-injection endpoint here —
# see the top of scripts/run_demo.py for what that means for the demo.
NAC_BASE=https://network-as-code.p-eu.apihub.nokia.io
NAC_API_KEY=7e36673cecmsh7893d9a01721e3bp14f3e9jsn49703c567867

# A real Nokia fixed simulator device — pick ONE and use it consistently so
# your zone-entry numbers (location, battery framing, etc.) stay coherent
# across scenarios. Full list of valid values is in the run_demo.py docstring.
NAC_DEVICE=+99999991000

# Agent layer (Resource & Tooling Guide: Gemini via Google AI Studio)
GOOGLE_API_KEY=

# Demo cast for YOUR backend/app only — never sent to Nokia
DEMO_MSISDN=+962790000001
DEMO_TRAVELLER_NAME=Sultan
DEMO_CONTACT_NAME=Omar
DEMO_CONTACT_MSISDN=+962790000002

# 60 turns a 75-minute monitoring window into 75 seconds of screen time.
# Surface this on screen as "demo mode · time x60" — do not hide it.
DEMO_TIME_SCALE=60
