# secrets — never committed
.env
backend/.env

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# db — the sqlite file holds traveller names, MSISDNs and contact numbers,
# so it is ignored wherever it lands. It is written to backend/ when the
# backend is started from that directory (its DATABASE_URL is relative) and
# to the repo root when it is started from here, and only the first of
# those was covered before.
*.db
*.db-journal
# WAL mode (see backend/app/db.py) leaves these two alongside the db file.
*.db-wal
*.db-shm

# local verification screenshots / ui dumps, not part of the deliverable
app/*.png
app/ui.xml

# flutter
app/build/
app/.dart_tool/
app/.flutter-plugin-dependencies
app/android/.gradle/
app/android/.kotlin/

# node (dashboard)
dashboard/node_modules/
dashboard/dist/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Reference docs are third-party or internal and are not published to this
# repo — but docs/screenshots/ is a deliverable (every image in the pitch
# deck, taken from the running build), so it ships. A trailing-slash
# ignore would stop git descending into docs/ at all, and the negation
# below would never be consulted; `docs/*` is what makes it work.
docs/*
!docs/screenshots/

# stale duplicate of scripts/run_demo.py, kept locally only
demo script/

# submission archive — built from this tree, never part of it
SignalGuard_source.zip
