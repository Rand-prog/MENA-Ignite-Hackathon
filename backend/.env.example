# Copy to .env and fill in. Never commit the real .env.

# Nokia Network as Code sandbox
NAC_BASE=https://network-as-code.p-eu.apihub.nokia.io
NAC_API_KEY=
# One of the fixed simulator devices — see docs/nokia-api-catalog.md
NAC_DEVICE=+99999991000

# Gemini via Google AI Studio (mandatory AI Resource & Tooling Guide)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_RISK_MODEL=gemini-flash-lite-latest

# WhatsApp via Twilio (sandbox or an approved sender). Leave blank to run
# with WhatsApp sending disabled — messages are logged, not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Backend
SIGNALGUARD_DEMO_MODE=true
# Demo aid, off by default. A new trip passes through BUFFER in about three
# seconds, which is long enough for the agent and too short for a person to
# read the app's approach screen. Set this to hold it there (seconds) when
# you want to see or record that screen. Never set it outside a demo: it
# delays the moment a real crossing becomes monitored.
SIGNALGUARD_DEMO_BUFFER_HOLD_SEC=0
DATABASE_URL=sqlite+aiosqlite:///./signalguard.db
SIGNALGUARD_WEBHOOK_BASE=https://example.com
# Bearer token for the CAMARA notification sink (sinkCredential on the
# Device Reachability Status subscription). Blank in the sandbox.
NAC_SINK_ACCESS_TOKEN=

# Deterministic fallback risk model bounds (minutes)
WINDOW_FLOOR_MIN=30
WINDOW_CEILING_MIN=180
TIER1_GRACE_MIN=20
